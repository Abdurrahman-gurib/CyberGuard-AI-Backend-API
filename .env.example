# --- Server ---
PORT=3000
# Comma-separated list of allowed browser origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Leave DATABASE_URL empty to use a local SQLite file (cyberguard.sqlite) for development.
# On Render / production set the PostgreSQL connection string, e.g.
# DATABASE_URL=postgres://user:password@host:5432/cyberguard
DATABASE_URL=
# Set to "true" when the Postgres host requires SSL (Render does)
DATABASE_SSL=true

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- AI providers (server-side only, never exposed to the browser) ---
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
